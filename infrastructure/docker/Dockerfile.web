FROM node:22-slim AS deps
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm ci --omit=dev || npm install --omit=dev

FROM node:22-slim AS builder
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm ci || npm install
COPY apps/web/ .
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
RUN npm run build

FROM node:22-slim AS runtime
ENV NODE_ENV=production
RUN useradd --create-home --shell /usr/sbin/nologin --uid 10001 olbostax
WORKDIR /app
COPY --from=deps --chown=olbostax:olbostax /app/node_modules ./node_modules
COPY --from=builder --chown=olbostax:olbostax /app/.next ./.next
COPY --from=builder --chown=olbostax:olbostax /app/public ./public
COPY --from=builder --chown=olbostax:olbostax /app/package.json ./package.json
USER olbostax
EXPOSE 3000
CMD ["npx", "next", "start"]
