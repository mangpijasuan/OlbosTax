# ---------------------------------------------------------------------------
# OlbosTax environment template.  Copy to .env for local development ONLY.
# Never commit a populated .env.  Production values come from the secret
# manager (see infrastructure/README.md), never from a file in the repo.
# ---------------------------------------------------------------------------

OLBOSTAX_ENV=local                     # local | development | staging | production

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://olbostax:olbostax@localhost:5432/olbostax

# --- Cryptography ----------------------------------------------------------
# Local dev only.  In every other environment these are resolved from KMS /
# the secret manager and MUST NOT be set as plain environment variables.
# Generate with: python -m olbostax_security.keys generate-local
OLBOSTAX_FIELD_ENCRYPTION_KEYS=       # JSON: {"1": "<urlsafe-b64 32 bytes>"}
OLBOSTAX_ACTIVE_KEY_ID=1
OLBOSTAX_SESSION_SECRET=              # 64 hex chars, local dev only

# --- E-file ----------------------------------------------------------------
# mock  -> MockEFileProvider, never reaches the IRS or the OTC.
# There is intentionally no value here that enables live transmission; see
# docs/EFILE_DESIGN.md and COMPLIANCE_STATUS.md.
OLBOSTAX_EFILE_PROVIDER=mock

# --- Payments --------------------------------------------------------------
OLBOSTAX_PAYMENT_PROVIDER=mock
OLBOSTAX_PAYMENT_PUBLIC_KEY=
OLBOSTAX_PAYMENT_SECRET_KEY=

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
